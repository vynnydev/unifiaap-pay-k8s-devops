# TODO.md
# NOTES.md

# Local test files
test-local/
sandbox/

# Performance profiling
*.prof
*.pprof

# ===================================
# ALLOW THESE FILES
# ===================================

# Keep example files
!*.example
!*.sample
!*.template

# Keep .gitkeep for empty directories
!.gitkeep

# Keep README files
!README.md
!README

# Keep LICENSE
!LICENSE
!LICENSE.md

# Keep documentation
!docs/**/*.md

# ===================================
# END OF GITIGNORE
# ===================================